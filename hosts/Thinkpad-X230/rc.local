#!/bin/sh
# Default rc.local for void; add your custom commands here.
#
# This is run by runit in stage 2 before the services are executed
# (see /etc/runit/2).

# Apply the local ACPI wakeup policy.
if [ -x /usr/local/sbin/configure-wakeup-sources ]; then
    /usr/local/sbin/configure-wakeup-sources
fi
